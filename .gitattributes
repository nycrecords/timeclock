# Enforce LF line endings for shell scripts to prevent Docker errors on Windows
*.sh text eol=lf
docker-entrypoint.sh text eol=lf

# Auto-normalize all text files
* text=auto

# Ensure Windows batch files use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
